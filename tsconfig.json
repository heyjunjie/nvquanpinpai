{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@notbuy/localized",
    "paths": {"@notbuy/localized/*": ["./frontend/localized/*"]},
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["frontend"]
}
